{
  "name": "@purplerbr/ui",
  "version": "0.0.0",
  "description": "Componentes React da Purpler (Tailwind + shadcn/ui), em design atômico.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplerbr/purpler-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./button": {
      "types": "./dist/atoms/Button/index.d.ts",
      "import": "./dist/atoms/Button/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "exports:sync": "node scripts/exports.ts --write",
    "storybook": "yarn workspace @purplerbr/tokens build && storybook dev --port 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "yarn workspace @purplerbr/tokens build && storybook build --output-dir storybook-static",
    "shadcn": "shadcn"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@purplerbr/tokens": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "~10.6.8",
    "@storybook/addon-docs": "~10.6.8",
    "@storybook/react-vite": "~10.6.8",
    "@tailwindcss/vite": "~4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "lucide-react": "^1.77.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "shadcn": "~4.23.0",
    "storybook": "~10.6.8",
    "tailwindcss": "~4.3.5",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest-axe": "^0.1.0"
  }
}
