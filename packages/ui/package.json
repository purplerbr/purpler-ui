{
  "name": "@purplerbr/ui",
  "version": "0.13.0",
  "description": "Componentes React da Purpler (Tailwind + shadcn/ui), em design atômico.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplerbr/purpler-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
